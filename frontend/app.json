{
  "expo": {
    "name": "ManaLife Calendar",
    "slug": "manalife-calendar",
    "version": "1.0.0",
    "description": "Premium offline-first Telugu Panchang & Hindu devotional calendar. Daily Tithi, Nakshatram, Rahukalam, Yamagandam, Gulika Kalam, Sunrise/Sunset, Hindu festivals, Vratham details, daily slokas and devotional quotes — with English and Telugu language support.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "manalife",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#D4AF37",
    "backgroundColor": "#060B19",
    "notification": {
      "icon": "./assets/images/adaptive-icon.png",
      "color": "#D4AF37"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.telugupanchangapp.ej8384",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "ManaLife Calendar",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.emergent.telugupanchangapp.ej8384",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1128",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png"
      },
      "icon": "./assets/images/icon.png",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#D4AF37"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#060B19",
          "dark": {
            "image": "./assets/images/splash-image.png",
            "backgroundColor": "#060B19"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://telugu-panchang-app.preview.emergentagent.com/api/privacy",
      "supportEmail": "support@manalife-calendar.app",
      "router": {},
      "eas": {
        "projectId": "74fff87b-77b0-4655-9e99-df5bd98ab9c6"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/74fff87b-77b0-4655-9e99-df5bd98ab9c6"
    }
  }
}
